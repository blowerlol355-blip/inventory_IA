# Copia este archivo a .env y completa los valores.

# --- Supabase ---
# Project Settings > Database > Connection string > "Session pooler" (funciona con IPv4).
# Cambia el prefijo "postgresql://" por "postgresql+asyncpg://".
DATABASE_URL=postgresql+asyncpg://postgres.TU_REF:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Project Settings > API: URL del proyecto y una secret key (sb_secret_...). Nunca en el frontend.
SUPABASE_URL=https://TU_REF.supabase.co
SUPABASE_SECRET_KEY=
# Bucket privado para los archivos (la API lo crea si no existe).
STORAGE_BUCKET=documents

# --- Autenticación ---
# Genera uno con: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto-por-un-secreto-largo
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7

# --- IA ---
# gemini (por defecto, capa gratuita): una sola clave de https://aistudio.google.com/apikey
# sirve para el chat, el OCR, la clasificación y los embeddings.
# anthropic: Claude. fake: respuestas de prueba sin API key.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# La capa gratuita da ~20 peticiones/día por modelo: si uno se agota (429) o está saturado
# (503) se usa el siguiente. Clasificar y OCR empiezan por los modelos ligeros.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview
GEMINI_TASK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5-5

# --- Embeddings ---
# gemini | voyage | hash (prueba). Cambiarlo exige reindexar: python -m app.scripts.reindex
EMBEDDING_PROVIDER=gemini
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4
EMBEDDING_DIM=1024

# --- Worker ---
# true: el procesamiento de documentos corre dentro de la API (un solo proceso).
RUN_WORKER_IN_API=true

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000
